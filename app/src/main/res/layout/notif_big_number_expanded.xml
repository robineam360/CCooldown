<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded view for the "big number" style: the same headline row, then the
    usual bar panel underneath as a bitmap. Height is generous here, so the
    number goes up to 44sp. Number trails, matching the collapsed row and the
    other styles.

    Text colours come from the platform's own notification appearances, never from
    ?android:attr/textColorPrimary: that resolves against Theme.ClaudeUsage (light
    in values/, dark in values-night/), not against the shade, which produced dark
    text on a dark shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- CCRM-56 (Provider Identity): the mark rides the label line. -->
                <ImageView
                    android:id="@+id/provider_mark"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/title"
                    style="@android:style/TextAppearance.Material.Notification.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/bar"
                android:layout_width="match_parent"
                android:layout_height="13dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/sub"
                style="@android:style/TextAppearance.Material.Notification.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- CCRM-22 (Used or Left): in Left mode the number is the remainder and the
             small caption below says so; Used mode keeps the caption gone. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/pct"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="44sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/pct_caption"
                style="@android:style/TextAppearance.Material.Notification.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:text="LEFT"
                android:visibility="gone"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:importantForAccessibility="no" />
</LinearLayout>
