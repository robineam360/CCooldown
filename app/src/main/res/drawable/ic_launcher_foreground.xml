<?xml version="1.0" encoding="utf-8"?>
<!-- CCRM-45 (Tracker Icon): hourglass on a container circle, per the approved
     round-3 wireframe (design/tracker-icon-m3-wireframe.html, option B). Container and
     glass live together in this layer so launcher parallax keeps them concentric.
     Geometry: the wireframe's 64-grid shifted +22 into the 108 viewport, container
     r=31 at 1x — CCRM-56 (Provider Identity)'s icon review (2026-09-06) asked for a
     bolder glyph with less dead ground, so the whole group scales 1.3x from centre,
     pushing the container to r=40 and intentionally past the nominal 66dp safe
     circle. Confirmed acceptable: modern launcher masks are lenient in practice.
     CCRM-56 (Provider Identity): the lower bulb is now three sand bands — blue at
     the base, green, then the orange that is pouring (the top sand and falling
     grain turn orange too) — so the icon reads "the Claude window is running"
     without a percentage, and the container recolours to slate so all three
     provider colours sit on neutral ground. Per
     design/provider-identity-wireframe.html section 3 (rev B, decision 3): each
     band stays >= 3dp at a 48dp launcher tile or the middle one vanishes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.3"
        android:scaleY="1.3">
        <!-- container: slate, neutral ground for all three provider colours -->
        <path
            android:pathData="M23,54 a31,31 0 1 0 62,0 a31,31 0 1 0 -62,0"
            android:fillColor="#1E2430" />
        <!-- top sand: pouring, orange gradient — the Claude window is the one running -->
        <path android:pathData="M48.5,41 c1,4 4,6 5.5,8.5 c1.5,-2.5 4.5,-4.5 5.5,-8.5 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="41"
                    android:endX="54"
                    android:endY="49.5"
                    android:startColor="#E59980"
                    android:endColor="#D97757" />
            </aapt:attr>
        </path>
        <!-- lower bulb: three sand bands, clipped to the glass interior. Blue at the
             base, green, then orange — the mound rises to ~58.5. -->
        <group>
            <clip-path android:pathData="M45,71 c0,-9 7,-12 9,-17 c2,5 9,8 9,17 z" />
            <path android:pathData="M40,66.5 h28 v6 h-28 z" android:fillColor="#4285F4" />
            <path android:pathData="M40,62.5 h28 v4 h-28 z" android:fillColor="#10A37F" />
            <path android:pathData="M40,58.5 h28 v4 h-28 z" android:fillColor="#D97757" />
        </group>
        <!-- falling grain: orange, mid-pour between the neck and the rising mound -->
        <path
            android:pathData="M53.2,52 a0.8,0.8 0 0 1 1.6,0 v6.5 a0.8,0.8 0 0 1 -1.6,0 z"
            android:fillColor="#E59980" />
        <!-- glass outline: cream -->
        <path
            android:pathData="M45,37 c0,9 7,12 9,17 c2,-5 9,-8 9,-17 M45,71 c0,-9 7,-12 9,-17 c2,5 9,8 9,17"
            android:strokeColor="#FFF6F1"
            android:strokeWidth="5.7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- caps: cream -->
        <path
            android:pathData="M42,35 h24 M42,73 h24"
            android:strokeColor="#FFF6F1"
            android:strokeWidth="7.6"
            android:strokeLineCap="round" />
    </group>
</vector>
