<?xml version="1.0" encoding="utf-8"?>
<!-- Round in-app rendition of the launcher icon (About screen, fallbacks).
     CCRM-45 (Tracker Icon): hourglass on the ground, same 108 grid as the adaptive
     layers, drawn as a 48dp disc.
     CCRM-56 (Provider Identity): slate ground, slate container, three-sand lower
     bulb, orange pouring top, glyph scaled 1.3x from centre — redrawn to match
     ic_launcher_foreground.xml and ic_launcher_background.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- disc: the background gradient, clipped round -->
    <path android:pathData="M54,4 a50,50 0 1 0 0,100 a50,50 0 1 0 0,-100 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="27"
                android:gradientRadius="103">
                <item android:offset="0" android:color="#3A4356" />
                <item android:offset="0.6" android:color="#242B38" />
                <item android:offset="1" android:color="#12161E" />
            </gradient>
        </aapt:attr>
    </path>
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.3"
        android:scaleY="1.3">
        <path
            android:pathData="M23,54 a31,31 0 1 0 62,0 a31,31 0 1 0 -62,0"
            android:fillColor="#1E2430" />
        <path android:pathData="M48.5,41 c1,4 4,6 5.5,8.5 c1.5,-2.5 4.5,-4.5 5.5,-8.5 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="41"
                    android:endX="54"
                    android:endY="49.5"
                    android:startColor="#E59980"
                    android:endColor="#D97757" />
            </aapt:attr>
        </path>
        <group>
            <clip-path android:pathData="M45,71 c0,-9 7,-12 9,-17 c2,5 9,8 9,17 z" />
            <path android:pathData="M40,66.5 h28 v6 h-28 z" android:fillColor="#4285F4" />
            <path android:pathData="M40,62.5 h28 v4 h-28 z" android:fillColor="#10A37F" />
            <path android:pathData="M40,58.5 h28 v4 h-28 z" android:fillColor="#D97757" />
        </group>
        <path
            android:pathData="M53.2,52 a0.8,0.8 0 0 1 1.6,0 v6.5 a0.8,0.8 0 0 1 -1.6,0 z"
            android:fillColor="#E59980" />
        <path
            android:pathData="M45,37 c0,9 7,12 9,17 c2,-5 9,-8 9,-17 M45,71 c0,-9 7,-12 9,-17 c2,5 9,8 9,17"
            android:strokeColor="#FFF6F1"
            android:strokeWidth="5.7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M42,35 h24 M42,73 h24"
            android:strokeColor="#FFF6F1"
            android:strokeWidth="7.6"
            android:strokeLineCap="round" />
    </group>
</vector>
