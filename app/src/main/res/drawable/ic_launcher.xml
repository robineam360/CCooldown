<?xml version="1.0" encoding="utf-8"?>
<!-- Round in-app rendition of the launcher icon (About screen, fallbacks).
     CCRM-45 (Tracker Icon): hourglass on the warm radial ground — same 108 grid as
     the adaptive layers, drawn as a 48dp disc. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- disc: the background gradient, clipped round -->
    <path android:pathData="M54,4 a50,50 0 1 0 0,100 a50,50 0 1 0 0,-100 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32"
                android:centerY="27"
                android:gradientRadius="103"
                android:startColor="#D96F42"
                android:centerColor="#B3521F"
                android:endColor="#8A3A12" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M23,54 a31,31 0 1 0 62,0 a31,31 0 1 0 -62,0"
        android:fillColor="#C4622D" />
    <path android:pathData="M48.5,41 c1,4 4,6 5.5,8.5 c1.5,-2.5 4.5,-4.5 5.5,-8.5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="41"
                android:endX="54"
                android:endY="49.5"
                android:startColor="#FFE3D5"
                android:endColor="#FFB98F" />
        </aapt:attr>
    </path>
    <path
        android:pathData="M48,69.5 h12 c-1,-4.5 -4.5,-6 -6,-8 c-1.5,2 -5,3.5 -6,8 z"
        android:fillColor="#FFB98F" />
    <path
        android:pathData="M53.2,58.8 a0.8,0.8 0 0 1 1.6,0 v7.4 a0.8,0.8 0 0 1 -1.6,0 z"
        android:fillColor="#FFDBCB" />
    <path
        android:pathData="M45,37 c0,9 7,12 9,17 c2,-5 9,-8 9,-17 M45,71 c0,-9 7,-12 9,-17 c2,5 9,8 9,17"
        android:strokeColor="#FFF6F1"
        android:strokeWidth="5.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M42,35 h24 M42,73 h24"
        android:strokeColor="#FFF6F1"
        android:strokeWidth="7.6"
        android:strokeLineCap="round" />
</vector>
