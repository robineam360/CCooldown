<?xml version="1.0" encoding="utf-8"?>
<!-- Round in-app rendition of the launcher icon (About screen, fallbacks).
     CCRM-42 (App Icon): reset ring on the dark gradient, matching AppIcon.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path android:pathData="M24,2 C36.15,2 46,11.85 46,24 C46,36.15 36.15,46 24,46 C11.85,46 2,36.15 2,24 C2,11.85 11.85,2 24,2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24"
                android:startY="2"
                android:endX="24"
                android:endY="46"
                android:startColor="#242B38"
                android:endColor="#12161E" />
        </aapt:attr>
    </path>
    <!-- Ring at the same 68% optical weight: r=12.65, stroke=4.46 inside the 44dp disc. -->
    <path
        android:pathData="M11.35,24 a12.65,12.65 0 1 0 25.3,0 a12.65,12.65 0 1 0 -25.3,0"
        android:strokeColor="#343F50"
        android:strokeWidth="4.46" />
    <path
        android:pathData="M24,11.35 A12.65,12.65 0 1 1 11.54,26.2"
        android:strokeWidth="4.46"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="11.35"
                android:startY="11.35"
                android:endX="36.65"
                android:endY="36.65"
                android:startColor="#F2B25C"
                android:endColor="#E8734D" />
        </aapt:attr>
    </path>
</vector>
