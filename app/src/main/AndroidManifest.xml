<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Window pings (CCRM-17) need to fire at an exact minute: a window's boundaries
      follow the message that opens it, so an alarm 3 minutes late costs 3 minutes of
      every window for the rest of the day. USE_EXACT_ALARM is Play-restricted, which
      does not apply here — this app is sideload-only. SCHEDULE_EXACT_ALARM is the
      user-revocable fallback for older releases.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Alarms are cleared on reboot, so they have to be re-armed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sideload-only app (never Play Store): allowed to enumerate installed
         browsers so the sign-in "open with" picker can list them reliably,
         including on OEM skins where a scoped <queries> under-reports.
         Lint pushes for a scoped <queries> instead; that's the right advice for a
         Play Store app, where this permission needs a declared use case and can
         block a release. It doesn't apply here, and a scoped list is exactly what
         under-reports on the skins we care about. Suppressed deliberately —
         revisit if this app is ever published. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.ClaudeUsage"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules">

        <!-- Handle size changes ourselves instead of being recreated. Compose
             relayouts on its own, and on a foldable the alternative is that every
             fold or unfold tears the activity down mid-refresh: the spinner and
             any error message live in remember{} state and would vanish with it.
             uiMode is deliberately absent — a day/night switch should still
             recreate, which is how the theme gets reapplied. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.PersonalTileService"
            android:label="Claude Personal"
            android:icon="@drawable/ic_stat_bars"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.WorkTileService"
            android:label="Claude Work"
            android:icon="@drawable/ic_stat_bars"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.UsageWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BarWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bar_widget_info" />
        </receiver>

        <receiver
            android:name=".notify.PinnedRefreshReceiver"
            android:exported="false" />

        <receiver
            android:name=".ping.PingAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".ping.PingBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
